{
  "name": "@leotus-richard/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agents for the software development lifecycle, installable into the coding tools you choose, with skills imported from AI-SKILLS.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Leotus-Richard/agents.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "bin": {
    "agents": "scripts/install.mjs"
  },
  "files": [
    "agents/",
    "registry/agents.json",
    "scripts/install.mjs",
    "scripts/definitions.mjs",
    "scripts/writer.mjs",
    "targets/"
  ],
  "scripts": {
    "agents:install": "node scripts/install.mjs",
    "validate": "node scripts/validate.mjs",
    "check:skills": "node scripts/check-skills.mjs",
    "catalog": "node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}
